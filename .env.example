# GitHub PAT used by scripts/sync-docc.mjs and scripts/sync-changelog.mjs to call
# the GitHub REST API without rate limiting. Read-only is sufficient.
GITHUB_TOKEN=

# Optional override: when set to a local checkout of ShipItSwifty, sync:docs:local
# will build DocC from that path instead of fetching a release asset. Useful in dev.
SHIPITSWIFTY_PATH=../ShipItSwifty

# Vercel injects these automatically in production builds; they are listed here
# for documentation only.
# VERCEL_ENV=
# VERCEL_URL=
