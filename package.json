{
  "name": "shipitswifty-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site and documentation for ShipItSwifty.",
  "homepage": "https://shipitswifty.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipItSwifty/website.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:docs": "node scripts/sync-docc.mjs",
    "sync:docs:local": "SHIPITSWIFTY_PATH=${SHIPITSWIFTY_PATH:-../ShipItSwifty} node scripts/build-docc-local.mjs",
    "prebuild": "node scripts/prebuild.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "flexsearch": "0.8.212",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-slugger": "2.0.0",
    "globals": "17.11.0",
    "gray-matter": "4.0.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  }
}
